{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "pull-request-title-pattern": "chore${scope}: publier la version${component} ${version}",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "forgenet",
      "initial-version": "0.1.0",
      "bump-minor-pre-major": true,
      "prerelease": true,
      "extra-files": [
        { "type": "generic", "path": "internal/version/version.go" },
        { "type": "generic", "path": "deploy/install.sh" },
        { "type": "generic", "path": "deploy/.env.example" }
      ],
      "changelog-sections": [
        { "type": "feat", "section": "Fonctionnalités" },
        { "type": "fix", "section": "Corrections" },
        { "type": "perf", "section": "Performances" },
        { "type": "refactor", "section": "Refactorisation" },
        { "type": "revert", "section": "Retours arrière" },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "style", "section": "Style", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "chore", "section": "Maintenance", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true }
      ]
    }
  }
}
