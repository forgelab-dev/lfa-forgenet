# ─── Secrets & configuration locale ────────────────────────────────────────
# ForgeNet manipule des tokens Vault, des clés de registry et des clés de
# paiement (FedaPay, Kkiapay, PayPal) : rien de tout cela ne doit être commité.
.env
.env.*
!.env.example
*.local
secrets/
*.pem
*.key
*.p12
*.keystore
*.jks
credentials.json
service-account*.json

# ─── Outils & éditeurs ─────────────────────────────────────────────────────
.claude/
.cursor/
.aider*
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.swp
*.swo
*~

