# Modèle du fichier .env de l'installation standard. install.sh l'écrit lui-même
# (droits 0600) : ne le remplir à la main que pour une installation manuelle.

# Version de l'image du serveur (ghcr.io/forgelab-dev/forgenet-server).
# x-release-please-start-version
FORGENET_VERSION=0.2.0
# x-release-please-end

# Empreinte de l'image, tirée de la fiche de la release (forgenet-release.json) :
# elle désigne l'image exacte signée par la CI. Écrite par install.sh et par la
# mise à jour ; vide, l'étiquette de version seule est utilisée.
FORGENET_IMAGE_DIGEST=

# Dossier d'installation sur l'hôte (docker-compose.yml, .env), pour le
# conteneur de mise à jour (ADR-0011).
FORGENET_INSTALL_DIR=/opt/forgenet

# Annonce des nouvelles versions dans le dashboard : le serveur lit les
# releases de ForgeNet sur l'API GitHub une fois par jour, sans rien
# transmettre sur l'installation. « false » coupe cet appel (ADR-0011).
FORGENET_UPDATES_CHECK=true

# Nom de domaine du dashboard, dont l'enregistrement DNS pointe vers ce
# serveur. Vide : dashboard par tunnel SSH seulement (ADR-0009).
FORGENET_DOMAIN=

# Adresse qui reçoit les avis de Let's Encrypt (facultative).
FORGENET_ACME_EMAIL=

# Clé de signature des sessions : 32 caractères au moins (la commande
# ci-dessous en donne 64).
# openssl rand -hex 32
FORGENET_JWT_SECRET=

# Groupe propriétaire du socket Docker : stat -c %g /var/run/docker.sock
DOCKER_GID=
